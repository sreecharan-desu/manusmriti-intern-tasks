{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PYTHONPATH": "src",
    "UPLOAD_DB_PATH": "/tmp/uploads.sqlite",
    "UPLOAD_STORAGE_DIR": "/tmp/storage"
  },
  "functions": {
    "app.py": {
      "maxDuration": 20,
      "includeFiles": "src/**",
      "excludeFiles": "{tests/**,.venv/**,**/*.md}"
    }
  }
}
