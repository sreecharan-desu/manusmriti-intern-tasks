# Auth
AUTH_JWT_SECRET=replace-me
AUTH_DB_PATH=auth.sqlite
AUTH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://manusmriti-auth-ui.vercel.app

# Uploads
UPLOAD_DB_PATH=uploads.sqlite
UPLOAD_STORAGE_DIR=storage

# Optional persistent store on Vercel (leave as replace-me locally)
MONGO_URI=replace-me

# Classifier — offline fallback works without keys
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CLASSIFY_LOCK_PATH=/tmp/ticket-classifier.lock
CLASSIFY_LOCK_TIMEOUT=30
