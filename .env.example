# Classifier (optional — offline fallback works without these)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CLASSIFY_LOCK_PATH=/tmp/ticket-classifier.lock
CLASSIFY_LOCK_TIMEOUT=30
